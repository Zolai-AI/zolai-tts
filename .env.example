# Zolai-TTS environment template
# Copy to .env and fill values as needed. Never commit real secrets.
#
# Usage:
#   cp .env.example .env
#   chmod 600 .env
#   # edit .env, then export/source as needed by your shell/workflow
#
# Security: keys are read only from environment at runtime; do not commit .env.

# --- Gemini (optional hosted TTS) ---
# Preferred Gemini key variable:
ZOLAI_TTS_GEMINI_API_KEY=
# Fallback accepted by code:
GEMINI_API_KEY=

# Optional Gemini model/config overrides
ZOLAI_TTS_GEMINI_MODEL=gemini-2.5-flash-preview-tts
ZOLAI_TTS_GEMINI_BASE_URL=
ZOLAI_TTS_GEMINI_VOICE=

# Live smoke opt-in (1 enables live test in test_gemini.py when key is set)
ZOLAI_TTS_RUN_LIVE=0

# --- OpenRouter (optional OpenAI-compatible TTS) ---
# Preferred OpenRouter key variable:
ZOLAI_TTS_OPENROUTER_API_KEY=
# Fallback accepted by code:
OPENROUTER_API_KEY=

# Optional OpenRouter model/config overrides
# Correct free OpenRouter models (availability/quotas/data-use terms can change; not unlimited-free):
ZOLAI_TTS_OPENROUTER_MODEL=fish-audio/s2.1-pro-free:free
# ZOLAI_TTS_OPENROUTER_MODEL=heygen/heygen-voice-1-turbo:free
# Paid/credits option (depending on account/model):
# ZOLAI_TTS_OPENROUTER_MODEL=openai/gpt-4o-mini-tts
ZOLAI_TTS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ZOLAI_TTS_OPENROUTER_VOICE=alloy
ZOLAI_TTS_OPENROUTER_RESPONSE_FORMAT=mp3

# --- Runtime ---
# Optional XDG runtime dir override (used by UI runtime state/log fallback)
XDG_RUNTIME_DIR=
